# 이 파일을 복사해서 이름을 ".env.local" 로 바꾸고, 실제 발급받은 키를 넣으세요.
# .env.local 파일은 .gitignore에 등록되어 있어서 GitHub에 올라가지 않습니다.
# 아래 항목 중 값을 채운 소스만 자동으로 수집됩니다(비워두면 그냥 건너뜁니다).

# 기업마당(bizinfo.go.kr)
BIZINFO_API_KEY=여기에_발급받은_인증키를_붙여넣으세요

# 중소벤처24 공고정보/행사정보 - 기업마당(bizinfo)과 내용이 겹칠 가능성이 높아 연결하지
# 않기로 했습니다(2026-08-14). 다시 시도하려면 API마다 따로 발급되는 키/URL을 넣으세요.
SME24_ANNOUNCE_API_KEY=
SME24_ANNOUNCE_ENDPOINT=
SME24_EVENT_API_KEY=
SME24_EVENT_ENDPOINT=
# 아래 두 개(이노비즈확인서/메인비즈확인서)는 "공고 목록"이 아니라 특정 사업자등록번호
# 하나의 인증 여부를 조회하는 API라서 지금 이 수집 파이프라인에는 쓰이지 않습니다.
# 나중에 "사업자번호 입력 → 보유 인증 자동 확인" 기능을 만들 때 쓸 수 있어 자리만 남겨둡니다.
SME24_INNO_API_KEY=
SME24_MAIN_API_KEY=

# K-Startup Open API
KSTARTUP_API_KEY=
KSTARTUP_ENDPOINT=

# 기획재정부 API
MPB_API_KEY=
MPB_ENDPOINT=
