# 이 파일을 복사해서 이름을 ".env.local" 로 바꾸고, 실제 발급받은 키를 넣으세요.
# .env.local 파일은 .gitignore에 등록되어 있어서 GitHub에 올라가지 않습니다.
# 아래 항목 중 값을 채운 소스만 자동으로 수집됩니다(비워두면 그냥 건너뜁니다).

# 기업마당(bizinfo.go.kr)
BIZINFO_API_KEY=여기에_발급받은_인증키를_붙여넣으세요

# 중소벤처24 공고정보 - 2026-08-21 연결 완료. 파라미터명이 data.go.kr류와 달리
# "token"이며(withToken() 참고), portal.smes.go.kr 발급 API 상세페이지의 "호출 URL 예시"에서
# 정확한 엔드포인트를 확인하세요.
SME24_ANNOUNCE_API_KEY=
SME24_ANNOUNCE_ENDPOINT=https://portal.smes.go.kr/ione-gw/api/pblanc/list
# 행사정보 - 2026-08-21 연결 완료. 공고정보와 달리 POST + JSON 바디 방식입니다.
SME24_EVENT_API_KEY=
SME24_EVENT_ENDPOINT=https://portal.smes.go.kr/ione-gw/api/event/list
# 아래 세 개(이노비즈/메인비즈/벤처기업 확인서)는 "공고 목록"이 아니라 특정 사업자등록번호
# 하나의 인증 여부를 조회하는 API라서 지금 이 수집 파이프라인(fetch-and-tag.mjs)에는 쓰이지
# 않습니다. 나중에 "사업자번호 입력 → 보유 인증 자동 확인" 기능을 만들 때 쓸 수 있어
# 스펙만 기록해두고 코드는 아직 연결하지 않습니다.
#
# 2026-08-21 확인된 스펙 (셋 다 동일 API, prdocCd만 다름 - 요청 URL은 아직 미확인):
#   POST, body: { brno: "10자리 사업자등록번호", prdocCd: "<아래 코드>" }
#   인증: token 헤더 또는 token 쿼리스트링 중 택1
#   prdocCd 코드값 - 메인비즈확인서: Y104 / 이노비즈확인서: Y105 / 벤처기업확인서: Y106
#   결과코드: 0=정상, 2=데이터없음, 3=오류, 5=필수파라미터누락, 10=해당API인증키아님,
#             11=존재하지않는인증키, 12=인증키필요
SME24_INNO_API_KEY=
SME24_MAIN_API_KEY=
SME24_VENTURE_API_KEY=
SME24_CERT_ENDPOINT=

# K-Startup Open API
KSTARTUP_API_KEY=
KSTARTUP_ENDPOINT=

# 기획재정부 API
MPB_API_KEY=
MPB_ENDPOINT=

# NTIS(국가과학기술지식정보서비스) 국가R&D 과제검색 서비스(전체용)
# 이 API는 "지금 신청 가능한 공고"가 아니라 "과거~현재 수행된 R&D 과제 이력" 조회용이라
# fetch-and-tag.mjs(공고 수집)가 아니라 fetch-ntis.mjs(별도 스크립트)에서 사용합니다.
# 발급키는 NTIS 마이페이지 > 활용신청 상세 화면의 "키정보"에 있습니다.
NTIS_APPRV_KEY=여기에_발급받은_승인키를_붙여넣으세요
# 매일 이 키워드들로 검색해서 data/rnd-history.json을 갱신합니다. 쉼표로 구분.
NTIS_KEYWORDS=도소매업,AI
